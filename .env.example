# =============================================================
# BotGuard AI – Environment Configuration Example
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file with credentials.
# =============================================================

# ── Multi-Engine Intelligence Stack Artifact Paths ────────────
CALIBRATED_MODEL_PATH=backend/ml/artifacts/human_bot_model_calibrated.pkl
ANOMALY_DETECTOR_PATH=backend/ml/artifacts/anomaly_detector.pkl
TEMPORAL_MODEL_PATH=backend/ml/artifacts/temporal_model.pt
MODEL_REGISTRY_PATH=backend/ml/artifacts/model_registry.json
MODEL_VERSION=v1

# ── Service Configuration ─────────────────────────────────────
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173

# ── Database Configuration ────────────────────────────────────
# SQLite (Local Development Default):
DATABASE_URL=sqlite:///./botguard.db

# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# ── PostgreSQL Docker Variables (used by docker-compose.yml) ──
# POSTGRES_USER=botguard
# POSTGRES_PASSWORD=<your-secure-password-here>
# POSTGRES_DB=botguard

# ── Risk Engine Thresholds ────────────────────────────────────
COMPOSITE_ALLOW_RISK_THRESHOLD=35.0
COMPOSITE_CHALLENGE_RISK_THRESHOLD=65.0
